@@ -75,6 +75,14 @@
 def core.option.Option.unwrap {T : Type _} (x : Option T) : Result T :=
   Result.ofOption x Error.panic
 
+/-- Candidate model for a direct mutable-reference payload; not nested borrows. -/
+@[expose]
+def core.option.Option.unwrap.mut {T : Type _} (x : Option T) :
+    Result (T × (T → Option T)) :=
+  match x with
+  | none => .fail .panic
+  | some v => .ok (v, fun v => some v)
+
 @[step]
